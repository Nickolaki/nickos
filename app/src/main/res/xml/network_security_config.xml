<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0 has no ISRG Root X1 (added in 7.1.1) and its cross-sign expired, so Let's Encrypt fails there.
     Cleartext stays on: the LAN link, the movie server and http Jellyfin are all cleartext, and a config replaces
     usesCleartextTraffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/gts_root_r1" />
            <certificates src="@raw/gts_root_r4" />
        </trust-anchors>
    </base-config>
</network-security-config>
